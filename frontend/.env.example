# Copy to .env.local (git-ignored). Dev server only: shows "Isi otomatis" buttons on the login page.
# These values are never used in production builds.
VITE_DEV_ADMIN_PASSWORD=
VITE_DEV_DEMO_PASSWORD=
# Sample/demo server only: also show portal "Isi otomatis" in a production build (puts VITE_DEV_DEMO_PASSWORD in the public bundle).
# VITE_PUBLIC_AUTOFILL=1
# Same for the admin login (VITE_DEV_ADMIN_PASSWORD goes into the public bundle). Throw-away sample servers only.
# VITE_PUBLIC_AUTOFILL_ADMIN=1
