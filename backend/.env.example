# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_DEBUG=true             # false on the server
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Dev (Vite on :5173): http://127.0.0.1:5173,http://localhost:5173. Server: https://dev-siakadku.riplabs.co.id
DJANGO_CSRF_TRUSTED_ORIGINS=
# Show menu items of inactive modules as locked (MOD-04) instead of hiding them
SHOW_LOCKED_MODULE_MENU=false

DB_NAME=siakadku_framework
DB_USER=siakadku
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Used only by `manage.py seed_roles`. Account is created only if the password is set.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Optional: also create fictional demo users (dosen, staf, mahasiswa, pimpinan) with this password
SEED_DEMO_PASSWORD=
